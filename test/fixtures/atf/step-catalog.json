{
  "_meta": {
    "story": "SNSDK-67 (ATF S0 spike)",
    "source": "Read-only reads of sys_atf_step_config, var_dictionary (atf_input_variable), sys_choice, sys_atf_step and sys_variable_value on a Personal Developer Instance, 2026-09",
    "sanitized": "Only out-of-box platform metadata is included (step-config and variable-definition sys_ids, element names, choice values). Example values are synthetic or out-of-box demo data.",
    "consumers": ["S8 sn_atf_author step catalog", "S4 suite UI-step detection"],
    "provenance": {
      "variable_sys_ids": "43 of 45 input-variable sys_ids below are shipped verbatim as platform constants in @servicenow/sdk-core 4.11.2 (src/fluent/tables/atf/var_dictionary.now.ts). The two exceptions are the Run Server Side Script inputs (sdk_constant=false).",
      "step_config_sys_ids": "Verified on one instance only. They are not present as literals in @servicenow/sdk, sdk-api, sdk-cli, sdk-build-core or sdk-core 4.11.2. Indirect corroboration: on the instance, the SDK-constant variable rows point at exactly these step configs through var_dictionary.model_id. S8 must still check the step config name at runtime and fail closed on mismatch."
    }
  },
  "definition_tables": {
    "step_config": "sys_atf_step_config",
    "input_variables": "atf_input_variable (extends var_dictionary; join on var_dictionary.model_id = step config sys_id, key on element)",
    "output_variables": "atf_output_variable (extends var_dictionary)",
    "input_values": "sys_variable_value",
    "_note": "sn_schema on atf_input_variable shows only sys_id because its fields are inherited; query var_dictionary with sys_class_name=atf_input_variable."
  },
  "encoding": {
    "row_shape": {
      "document": "sys_atf_step",
      "document_key": "<sys_atf_step.sys_id>",
      "variable": "<var_dictionary sys_id of the input variable>",
      "value": "<string>",
      "order": "<var_dictionary.order of the input variable>"
    },
    "one_row_per_input": "Observed: steps created in the UI have one row for every input variable, including empty values.",
    "by_internal_type": {
      "table_name": "table name string, e.g. 'incident'",
      "conditions": "ServiceNow encoded query terminated by '^EQ', e.g. 'first_name=ATF^last_name=User^user_name=ATF.User^EQ'",
      "template_value": "encoded query terminated by '^EQ' (Set Field Values), e.g. 'short_description=Example^description=Example text^EQ'",
      "choice": "choice value, not label (see choices per input)",
      "boolean": "'true'/'false'; '0'/'1' also observed (enforce_security='0')",
      "integer": "decimal string, e.g. '200'",
      "reference": "32-hex sys_id, or a step output reference",
      "document_id": "32-hex sys_id, or a step output reference",
      "string": "plain text",
      "script": "raw JavaScript; the out-of-box wrapper is (function(outputs, steps, params, stepResult, assertEqual) { ... })(outputs, steps, params, stepResult, assertEqual);",
      "simple_name_values": "UNVERIFIED (empty on every observed row)"
    },
    "step_output_reference": {
      "stored": "{{step['<sys_atf_step sys_id>'].<output element>}}",
      "displayed": "{{Step <n>: <step config name>.<output label>}}",
      "examples": ["change_request={{step['a0000000000000000000000000000401'].record_id}}^EQ", "caller_id={{step['a0000000000000000000000000000402'].user}}^EQ"]
    }
  },
  "authoring_tables": {
    "_verification": "verified (sn_schema)",
    "sys_atf_test": {
      "name": "string(100), mandatory",
      "description": "string(1000)",
      "active": "boolean",
      "fail_on_server_error": "boolean",
      "enable_parameterized_testing": "boolean",
      "test_origin": { "choices": ["manual", "now_assist"] }
    },
    "sys_atf_step": {
      "test": "reference sys_atf_test, mandatory",
      "step_config": "reference sys_atf_step_config, mandatory",
      "order": "integer",
      "active": "boolean",
      "description": "string(1000) (UI generates it from the step config's description_generator)",
      "display_name": "translated_field(250)",
      "table": "table_name (mirrors the step's table input when present)",
      "timeout": "glide_duration",
      "notes": "string(1000)"
    },
    "sys_atf_test_suite": {
      "name": "string(100), mandatory",
      "description": "string(1000)",
      "active": "boolean",
      "parent": "reference sys_atf_test_suite",
      "input_filter": "conditions(4000)"
    },
    "sys_atf_test_suite_test": {
      "test_suite": "reference sys_atf_test_suite, mandatory",
      "test": "reference sys_atf_test, mandatory",
      "order": "integer",
      "abort_on_failure": "boolean"
    }
  },
