# ServiceNow MCP V2 configuration inventory.
#
# This committed file contains non-secret placeholders only. Do not put a
# bearer token, password, OAuth client secret, API key, encryption key, or
# provider credential here or in another repository dotenv file. Leave every
# secret assignment below empty and inject its value at process start through
# an approved supervisor, orchestrator, OS keychain, or secret manager.

# HTTP service and authenticated owner identity (owner/client IDs are non-secret).
MCP_HOST=127.0.0.1
MCP_PORT=3000
MCP_ALLOWED_HOSTS=127.0.0.1:3000
# MCP_ALLOWED_ORIGINS is intentionally unset, so browser origins are denied.
MCP_OWNER_ID=example-owner
MCP_CLIENT_ID=example-client
MCP_BEARER_TOKEN=
MCP_MAX_CONCURRENT_REQUESTS=2
MCP_MAX_CONNECTIONS=128
MCP_SHUTDOWN_GRACE_MS=10000

# Deny-by-default example policy. This permits only bounded incident reads.
SN_ALLOWED_READ_TABLES=incident
SN_ALLOWED_WRITE_TABLES=
SN_TABLE_ACCESS_TARGETS=[{"table":"incident","kind":"canonical","tools":["sn_query","sn_get"],"closureComplete":true,"relatedTables":["incident"]}]
# SN_ENCODED_QUERY_READ_POLICY is intentionally unset, so raw reads are denied.

# One explicit environment-only compatibility profile. Every tool invocation
# must pass profile="example-dev". For two or more profiles, use the protected
# out-of-band config/CLI workflow in docs/CLIENT-SETUP.md instead of duplicating
# plaintext SN_* values in dotenv files.
SN_PROFILE_NAME=example-dev
SN_INSTANCE=https://example.invalid
SN_AUTH_TYPE=oauth
SN_GRANT_TYPE=client_credentials
SN_CLIENT_ID=example-non-secret-oauth-client-id
SN_USER=
SN_PASSWORD=
SN_CLIENT_SECRET=
SN_API_KEY=
SN_PROFILE_ENCRYPTION_KEY=
SN_ALLOWED_INSTANCE_HOSTS=example.invalid
SN_TIMEOUT_MS=30000
SN_DISPLAY_VALUE=true
SN_REL_DEPTH=3
