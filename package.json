{
  "name": "@onlyflows/servicenow-mcp",
  "version": "2.0.0",
  "description": "stdio ServiceNow MCP server with 19 tools for CRUD, CMDB traversal, ATF testing, and explicit multi-instance profiles.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "servicenow-mcp": "./dist/index.js",
    "servicenow-mcp-profile": "./dist/profile-admin.js",
    "servicenow-mcp-setup": "./dist/setup.js"
  },
  "scripts": {
    "prebuild": "node scripts/clean-dist.mjs",
    "build": "tsc",
    "postbuild": "node scripts/set-bin-mode.mjs",
    "typecheck": "tsc --noEmit --pretty false",
    "lint": "eslint --max-warnings 0 src test scripts vitest.config.ts eslint.config.mjs",
    "start": "node dist/index.js",
    "dev": "npm run build && node --enable-source-maps dist/index.js",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:protocol": "vitest run test/snsdk-53-contract.test.ts test/snsdk-55-release-matrix.test.ts test/stdio-runtime.test.ts test/stdio-entrypoint.test.ts test/stdio-package-contract.test.ts test/http-cross-client.test.ts test/http-compatibility.test.ts test/http-request-policy.test.ts test/http-runtime.test.ts test/http-entrypoint.test.ts test/http-health.test.ts test/http-auth.test.ts test/container-artifact.test.ts",
    "test:profile": "vitest run test/profile-credentials.test.ts test/profile-manager.test.ts test/profile-admin.test.ts",
    "test:release": "vitest run test/snsdk-57-release-workflow.test.ts",
    "smoke": "node scripts/smoke-test.mjs",
    "inspector": "node scripts/inspector.mjs",
    "release:contract": "node scripts/release-validate.mjs",
    "release:check": "npm run release:contract && npm run typecheck && npm run lint && npm run build && npm run test:unit && npm run test:protocol && npm run test:profile && npm run test:release && npm pack --dry-run --json --ignore-scripts && npm audit --omit=dev --audit-level=moderate",
    "release:container": "npm run container:build && npm run container:validate && npm run container:scan",
    "container:build": "node scripts/container-build.mjs --local",
    "container:provenance": "node scripts/container-build.mjs --provenance",
    "container:validate": "node scripts/container-validate.mjs",
    "container:scan": "node scripts/container-scan.mjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "servicenow",
    "mcp",
    "model-context-protocol",
    "stdio",
    "itsm",
    "itom",
    "cmdb",
    "ai-tools"
  ],
  "author": "OnlyFlows <support@onlyflows.tech> (https://onlyflows.tech)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/onlyflowstech/servicenow-mcp"
  },
  "homepage": "https://github.com/onlyflowstech/servicenow-mcp#readme",
  "bugs": {
    "url": "https://github.com/onlyflowstech/servicenow-mcp/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hono/node-server": "2.0.12",
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "^3.25.76"
  },
  "overrides": {
    "@hono/node-server": "2.0.12"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "^20.11.0",
    "eslint": "9.39.5",
    "globals": "17.8.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "8.65.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.6"
  },
  "files": [
    ".env.example",
    "dist",
    "docs/ADDING-TOOLS.md",
    "docs/CLIENT-SETUP.md",
    "docs/CONTAINER-DEPLOYMENT.md",
    "docs/CROSS-CLIENT-RELEASE-MATRIX.md",
    "docs/ENTERPRISE-RELEASE-BOUNDARY.md",
    "docs/OPERATIONS-RUNBOOK.md",
    "docs/PRIVATE-CHATGPT-CONNECTIVITY.md",
    "docs/PRODUCTION-SECURITY.md",
    "docs/PROFILE-CREDENTIALS.md",
    "docs/RELEASE-VALIDATION.md",
    "docs/TESTING-OAUTH.md",
    "docs/V2-MIGRATION.md",
    "scripts/inspector.mjs",
    "scripts/release-validate.mjs",
    "scripts/smoke-test.mjs",
    "tools/inspector/package.json",
    "tools/inspector/package-lock.json",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ]
}
